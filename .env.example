# Development defaults. Never commit actual passwords or bootstrap tokens.
KENNY_HOST=127.0.0.1
PORT=3000
KENNY_DATA_DIR=.data
KENNY_ENV=development
KENNY_COOKIE_SECURE=0
# Set the public HTTPS origin behind your reverse proxy in production:
# KENNY_ENV=production
# KENNY_COOKIE_SECURE=1
# KENNY_ALLOWED_ORIGINS=https://shop.example.com
